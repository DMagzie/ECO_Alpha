DHWSYS   "dhwsys-ResidentialDHWSystem 1"  
   wsTUse = 125                         // Water use temperature (at the point of use), °F
   wsTSetpoint = 140                    // Setpoint temperature for HPWHs (whHeatSrc = ASHPX), °F
   wsTSetPointLH = 136                  // Setpoint temperature for loop heater, °F
   wsBranchModel = "DayWaste"           // Model used to simulate DHW branch losses
   wsShowerDayWasteF = 3                // used to determine ratio of Shower/Faucet water waste
   wsFaucetDayWasteF = 1                // used to determine ratio of Shower/Faucet water waste
   wsDayWasteBranchVolF = 1.4 * 19.84 * exp( -0.554 * 1/2)    // Number of branch volumes discarded per day (wsBranchModel = DayWaste) (expression)
   wsElecMtr = "MtrElec"                // Electric use meter
   wsFXHwMtr = "DHWMtrFXMix"
   wsWHHwMtr = "DHWMtrWH"
   wsCalcMode = "PreRun"                // specifies PreRun vs. Simulate

   DHWLOOPHEATER   "dhwlphtr-ResidentialDHWSystem 1"  
      whType = "BuiltUp"                // Type of water heater
      whHeatSrc = "ResistanceX"         // Fuel source for water heater
      whResType = "Typical"             // Control scheme for resistance loop tank heaters
      whMult = 1                        // Water heater multiplier
      whXBUEndUse = "User2"             // enduse to accumulate ASHPX backup heat elec use
      whInsulR = 16                     // Water heater tank insulation R-value (interior + exterior insulation), ft2-°F/Btuh
      whResHtPwr = 8750                 // Water heater resistance heat power (upper element watts), W
      whResHtPwr2 = 8750                // Water heater resistance heat power (lower element watts), W
      whVol = 120                       // Water heater tank volume per compressor (mult) (must be 0 or undefined for instantaneous), gal
      whTankCount = 1                   // Number of primary water heater tanks per compressor (mult)

   DHWHEATER   "dhwhtr1-t24std-CHPWH"  
      whType = "BuiltUp"                // Type of water heater
      whHeatSrc = "ASHPX"               // Fuel source for water heater
      whASHPType = "Scalable_SP"        // ASHP type (for new HPWH model)
      whXBUEndUse = "User2"             // enduse to accumulate ASHPX backup heat elec use
      whInsulR = 16                     // Water heater tank insulation R-value (interior + exterior insulation), ft2-°F/Btuh
      whHeatingCap = 999999             // Water heater compressor output (at air source temp = wsASHPTSrcDes), Btuh
      whVolRunning = 999                // Water heater tank volume needed in excess of heating capacity to get through heating event, gal

   DHWLOOP   "dhwlp-ResidentialDHWSystem 1"  
      wlMult = 1                        // DHW loop multiplier
      wlFlow = 8.5                      // DHW loop flow (gpm), gpm
      wlRunF = 1                        // Hourly fraction that recirc is assumed to operate in the DHW loop, frac
      wlFUA = 2                         // DHW loop imperfect insulation correction factor

      DHWLOOPPUMP   "dhwlppmp-ResidentialDHWSystem 1"  
         wlpPwr = 29                    // DHW loop pump power (W), W

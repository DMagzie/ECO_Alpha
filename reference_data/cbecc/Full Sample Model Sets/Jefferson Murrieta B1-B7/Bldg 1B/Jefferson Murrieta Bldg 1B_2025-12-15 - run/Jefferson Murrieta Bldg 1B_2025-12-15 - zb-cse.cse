   GAIN   "P2.0 (S1)_L1-znRfrg"  
      gnMeter = "MtrElec"               // Meter that tracks internal gain
      gnEndUse = "Refr"                 // Internal gain enduse
      gnPower = (1.44658 * 3412 / 24) * ( select( $isWeHol, RefrConst_WEH, default RefrConst_WD ) + select( $isWeHol, RefrTemp_WEH, default RefrTemp_WD ) * @znRes["P2.0 (S1)_L1-zn"].prior.H.tAir)    // Expression representing internal gain power, Btuh

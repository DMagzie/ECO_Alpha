   izZn1 = "P2.0 (S1)_L2-zn"            // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0                            // Area of low or only vent (typically VentOff), ft2
   izAHi = 1.076 * WINDOWVENTAVAIL      // Additional vent area (high vent or VentOn)  (expression/formula), ft2
   izHD = 27.67                         // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 0.5                        // Vent discharge coefficient coefficient
   izCpr = -0.1625                      // Wind pressure coefficient (for AIRNETEXT)
   izAFCat = "VentEx"                   // Air flow (infiltration) reporting category


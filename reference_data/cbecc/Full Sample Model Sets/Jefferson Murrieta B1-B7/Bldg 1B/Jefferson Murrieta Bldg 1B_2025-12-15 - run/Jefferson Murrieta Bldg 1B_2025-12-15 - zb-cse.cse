 verbose = -1          // suppress progress messages
 RUN                   // prerun #1: find daywaste fraction

ALTER  DHWSYS  "dhwsys-ResidentialDHWSystem 1"
   wsCalcMode = PreRun
endDHWSYS

 RUN                   // prerun #2: Ecosizer load

 UNSET verbose         // re-enable progress messages

ALTER DHWSYS   "dhwsys-ResidentialDHWSystem 1"  
 ALTER DHWLOOPHEATER   "dhwlphtr-ResidentialDHWSystem 1"  
   whTEx = $tDbO                        // Temperature surrounding tank (currently active only for ASHPX model, when no whZone specified), °F

 ALTER DHWHEATER   "dhwhtr1-t24std-CHPWH"  
   whTEx = $tDbO                        // Temperature surrounding tank (currently active only for ASHPX model, when no whZone specified), °F
   whASHPSrcT = $tDbO                   // Temperature source for compressor (currently active only for ASHPX model, when no whASHPSrcZn specified), °F

IZXFER   "P2.0 (S1)_L1-InfLU"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "P2.0 (S1)_L1-zn"            // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0.024203                     // Area of low or only vent (typically VentOff), ft2
   izHD = 3.17                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = 0.6                          // Wind pressure coefficient (for AIRNETEXT)
   izExp = 0.65                         // Opening exponent

IZXFER   "P2.0 (S1)_L1-InfLS"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "P2.0 (S1)_L1-zn"            // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0.048405                     // Area of low or only vent (typically VentOff), ft2
   izHD = 3.17                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = -0.65                        // Wind pressure coefficient (for AIRNETEXT)
   izExp = 0.65                         // Opening exponent


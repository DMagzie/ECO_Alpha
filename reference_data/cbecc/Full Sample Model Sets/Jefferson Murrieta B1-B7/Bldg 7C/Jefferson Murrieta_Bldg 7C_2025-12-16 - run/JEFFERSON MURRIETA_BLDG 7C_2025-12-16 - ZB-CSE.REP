        RSYS   "rsys-P2.1_20_L1 HVACSys"  
           rsType = "ASHP"                      // System type
           AUTOSIZE rsCapC
           AUTOSIZE rsCapAuxH
           AUTOSIZE rsCap47
           rsFxCapC = 1.2                       // Cooling sizing factor
           rsFChg = 0.96                        // Refrigerant charge adjustment factor
           rsSEER = 15.052632                   // Cooling SEER
           rsEER = 12.1875                      // Cooling EER (required for *PkgRoom types)
           rsVfPerTon = 350                     // CFM per Ton (default = 350)
           rsFanPwrH = 0.45                     // Heating fan power.  Heating air flow is estimated based on a 50 ?F temperature rise.
           rsFanPwrC = 0.45                     // Cooling fan power.
           rsParElec = ($tdboHrAv < 50.) * (1.-@RSYSRes["rsys-P2.1_20_L1 HVACSys"].prior.H.hrsOn) * @RSYS["rsys-P2.1_20_L1 HVACSys"].capNomC * 10./12000.    // Parasitic electric use, W

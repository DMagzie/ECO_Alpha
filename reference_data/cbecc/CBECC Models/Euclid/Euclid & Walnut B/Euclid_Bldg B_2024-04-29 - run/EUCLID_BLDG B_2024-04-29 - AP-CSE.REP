              gnFrRad = 0.2                     // Fraction of internal gain to Zone that is Radiant (single value or hourly profile)
        
           GAIN   "B4_414-znPpl"  
              gnPower = 15.7767 * 1106.43 * select( $dsDay==1, 0., default hourval(0.035,0.035,0.035,0.035,0.035,0.059,0.082,0.055,0.027,0.014,0.014,0.014,0.014,0.014,0.019,0.027,0.041,0.055,0.068,0.082,0.082,0.07,0.053,0.035)  * choose1($month, 1.19,1.11,1.02,0.93,0.84,0.8,0.82,0.88,0.98,1.07,1.16,1.21))    // Expression representing internal gain power, Btuh

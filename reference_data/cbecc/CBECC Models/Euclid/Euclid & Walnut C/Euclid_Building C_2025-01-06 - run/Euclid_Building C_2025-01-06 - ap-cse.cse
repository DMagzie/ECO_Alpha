      whXBUEndUse = "User2"             // enduse to accumulate ASHPX backup heat elec use
      whEff = 0.97                      // Water heater efficiency (for large storage & instantaneous), and recovery efficiency for UEF equipment
      whSBL = 57.75                     // Water heater stand-by losses (for large storage only), Btuh
      whVol = 100                       // Water heater tank volume per compressor (mult) (must be 0 or undefined for instantaneous), gal
      whFuelMtr = "MtrNatGas"           // Fuel use meter


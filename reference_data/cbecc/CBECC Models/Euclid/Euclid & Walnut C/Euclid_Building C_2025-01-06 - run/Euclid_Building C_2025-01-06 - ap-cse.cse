RSYS   "rsys-Res_West Facing_L01 HVACSys"  
   rsType = "ASHP"                      // System type
   AUTOSIZE rsCapC
   AUTOSIZE rsCapAuxH
   rsFxCapC = 1.2                       // Cooling sizing factor
   rsFChg = 0.96                        // Refrigerant charge adjustment factor
   rsSEER = 16                          // Cooling SEER
   rsEER = 12.5                         // Cooling EER (required for *PkgRoom types)
   rsVfPerTon = 350                     // CFM per Ton (default = 350)
   rsFanPwrH = 0.45                     // Heating fan power.  Heating air flow is estimated based on a 50 ?F temperature rise.
   rsFanPwrC = 0.45                     // Cooling fan power.
   rsParElec = ($tdboHrAv < 50.) * (1.-@RSYSRes["rsys-Res_West Facing_L01 HVACSys"].prior.H.hrsOn) * @RSYS["rsys-Res_West Facing_L01 HVACSys"].capNomC * 10./12000.    // Parasitic electric use, W
   rsHSPF = 9.411765                    // ratio of BTU heat output over the heating season to watt-hours of electricity used, ratio
   rsCap47 = 105840                     // Total rated heating capacity (@ 47°F), Btuh
   rsCap17 = 105840                     // Total rated heating capacity (@ 17°F), Btuh
   rsFxCapAuxH = 1.2                    // Auxiliary (backup) heating sizing factor
   rsOAVType = "None"                   // OAV system type

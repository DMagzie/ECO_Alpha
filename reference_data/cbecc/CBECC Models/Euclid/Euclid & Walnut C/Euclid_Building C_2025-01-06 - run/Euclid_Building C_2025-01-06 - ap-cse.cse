AIRHANDLER   "Inverter-Rm_L01 AirSys-ah"  
   ahSched = ON                         // Air handler schedule; OFF or ON, hourly schedulable by expression
   ahTsSp = ZN2                         // Supply temperature setpoint numeric value OR* choice of control method
   ahfanCycles = NO                     // Whether AH fan cycles with the zone thermostat
   ahTsMn = 58                          // Minimum supply temperature, °F
   ahTsMx = 95                          // Maximum supply temperature, °F
   sfanType = "DrawThru"                // Supply fan type/position
   sfanVfDs = 635                       // Supply fan design or rated (volumetric) air flow at rated pressure, cfm
   sfanVfMxF = 1                        // Supply fan overrun factor: maximum factor by which fan will exceed rated flow (default 1.3), mult
   sfanElecPwr = 0.309851               // Supply fan input power per unit air flow (at design flow and pressure), W/cfm
   sfanMotEff = 0.9                     // Supply fan motor/drive efficiency, frac
   sfanMotPos = IN_FLOW                 // Supply fan motor/drive position
   sfanMtr = "MtrElec"                  // Name of METER to accumulate energy use by this supply fan
   ahhcType = "AHP"                     // Heating coil type
   ahhcCapTRat = 17220.409103           // Total heating coil (output) capacity, Btuh
   ahhcMtr = "MtrElec"                  // Name of METER to accumulate energy use by this heating coil
   ahpCap17 = 8592.984142               // AHRI steady state rated capacity at 70 degF indoor (return), and 17 degF outdoor air temp, respectively, Btuh
   ahpCOP47 = 5.495666                  // Steady state (full power, no cycling) COP for compressor and crankcase heater at 47 degF outdoor and 70 indoor, kW
   ahpCOP17 = 3.364487                  // Steady state (full power, no cycling) COP for compressor and crankcase heater at 17 degF outdoor and 70 indoor, kW
   ahpCapSupH = 17220.409103            // Output capacity of the heat pump's supplemental heating coil, Btuh
   ahpTOff = 0                          // Heat pump compressor is disabled (only supplemental heater operates) when outdoor temperature falls below this temperature, °F
   ahpTOn = 0                           // Heat pump compressor is enabled when outdoor temperature is at or above this temperature, °F
   ahpSupHMtr = "MtrElec"               // Name of METER to accumulate energy use by this supp heat pump heating coil
   cchCM = TSTAT                        // Crankcase heater presence and control method
   cchPMx = 0.015                       // Crankcase resistance heater input power (max power if cchCM is PTC or PTC_CLO), kW
   cchTOn = 50                          // For cchCM = TSTAT, in subhours when compressor does not run, the crankcase heater turn-on outdoor temp, °F
   cchMtr = "MtrElec"                   // Name of METER to accumulate energy use by the crankcase heater
   ahccType = "DX"                      // Cooling coil type
   ahccCapTRat = 18779.590897           // Total cooling coil capacity (sensible + latent), Btuh
   ahccMtr = "MtrElec"                  // Name of METER to accumulate energy use by this cooling coil
   ahccEirR = 0.210053                  // DX compressor energy input ratio (EIR) at full load under rated conditions, ratio
   pydxCaptT = 0.874962, -0.001143, 0.000171, -0.00296, 0.00001, 
               -0.000059                // Coefficients of biquadratic polynomial function of entering air WB and condenser temps, used to adjust ahccCaptRat for the actual entering air temp, coefs
   pydxEirT = -1.063931, 0.030658, -0.000127, 0.015421, 0.00005, 
              -0.00021                  // Coefficients of biquadratic polynomial function of entering air WB and condenser temps, used to adjust ahccEirR for the actual entering air temp, coefs
   pydxEirUl = 0.20123, -0.031218, 1.950498, -1.120511    // Coefficients of cubic polynomial function of part load ratio used to adjust energy input to part load conditions, in the compressor unloading part load region (1 >= plr >= ahccMinUnldPlr), coefs
   ahccVfRperTon = 400                  // Air flow per ton during AHRI tests, cfm/ton
   oaMnCtrl = "Volume"                  // Minimum outside air flow control method
   oaVfDsMn = 0                         // Design minimum outside air flow, cfm
   oaEcoType = "None"                   // Economizer type
   oaOaLeak = 0                         // Outside air damper leakage to mixed air (default 0.1), frac
   oaRaLeak = 0                         // Return air damper leakage to mixed air (default 0.1), frac
   ahSOLeak = 0                         // Supply duct leakage to outdoors, expressed as a fraction of supply fan design flow, frac
   ahROLeak = 0                         // Return duct leakage FROM outdoors, expressed as a fraction of supply fan design flow, frac
   ahSOLoss = 0                         // Supply duct loss/gain to the outdoors, frac
   ahROLoss = 0                         // Return duct loss/gain to the outdoors, frac


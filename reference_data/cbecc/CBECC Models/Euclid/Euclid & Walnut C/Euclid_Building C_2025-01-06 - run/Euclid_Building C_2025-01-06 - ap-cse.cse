IZXFER   "ResidentialCeilingBelowAttic 1-BypassxA"  
   izNVType = "NONE"                    // Choice determining interzone ventilation
   izZn1 = "Res_West Facing_L03-zn"     // Name of primary zone (flow rates > 0 are into the primary zone)
   izZn2 = "ResidentialAttic-atc"       // Name of secondary zone
   izHConst = 0.015 * 4805 * select(@znRes["Res_West Facing_L03-zn"].prior.H.tAir - @znRes["ResidentialAttic-atc"].prior.H.tAir > 0., 1., default 0.)    // expression describing Conductance between zones, Btu/°F


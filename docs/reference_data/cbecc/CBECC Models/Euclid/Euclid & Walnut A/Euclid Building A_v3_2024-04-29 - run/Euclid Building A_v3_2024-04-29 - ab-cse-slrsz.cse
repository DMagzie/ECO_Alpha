DESCOND   "ClgDC_0p4pct_Aug"  
   dcDB = 104.4                         // Cooling design dry-bulb temperature, °F
   dcDay = Aug 21                       // Calendar date for this design cooling conditions
   dcMCDBR = 32.5                       // Coincident daily dry-bulb range, °F
   dcMCWB = 69.5                        // Coincident wet-bulb temperature, °F
   dcMCWBR = 11.3                       // Coincident daily wet-bulb range, °F
   dcTauB = 0.367                       // ASHRAE beam 'pseudo optical depth'
   dcTauD = 2.46                        // ASHRAE diffuse 'pseudo optical depth'

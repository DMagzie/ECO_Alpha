IZXFER   "A1_L1 1-InfLU"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "A1_L1 1-zn"                 // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0.011949                     // Area of low or only vent (typically VentOff), ft2
   izHD = 2.75                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = 0.6                          // Wind pressure coefficient (for AIRNETEXT)
   izExp = 0.65                         // Opening exponent


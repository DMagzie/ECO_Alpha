EXPORT   "x-hvacCaps"  
   exExportfile = "xf-hvacCaps"         // Name of EXPORTFILE to write simulation results to
   exType = "UDT"                       // Export type
   exFreq = "YEAR"                      // Time interval for generating rows of export data
   exHeader = "COLUMNSONLY"             // export header which gives the export type, object being exported, time interval, column headings, etc.

   EXPORTCOL   "xc-hvacCaps"  
      colVal = @top.runDateTime         // Value to show in this position in each row of export
      colHead = "runDateTime"           // Text used for field name in export header

   EXPORTCOL   "xc1-A1_L1 1 HVACSys-Name"  
      colVal = "A1_L1 1 HVACSys"        // Value to show in this position in each row of export
      colHead = "SysName"               // Text used for field name in export header

   EXPORTCOL   "xc1-A1_L1 1 HVACSys-HtgCap"  
      colVal = @Rsys["rsys-A1_L1 1 HVACSys"].Cap47/1000    // Value to show in this position in each row of export

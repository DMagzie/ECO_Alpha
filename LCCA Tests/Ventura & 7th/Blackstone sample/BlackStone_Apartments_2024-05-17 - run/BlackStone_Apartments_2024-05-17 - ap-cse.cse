   rsCap47 = 1314000                    // Total rated heating capacity (@ 47°F), Btuh
   rsCap17 = 998640                     // Total rated heating capacity (@ 17°F), Btuh
   rsFxCapAuxH = 1.2                    // Auxiliary (backup) heating sizing factor

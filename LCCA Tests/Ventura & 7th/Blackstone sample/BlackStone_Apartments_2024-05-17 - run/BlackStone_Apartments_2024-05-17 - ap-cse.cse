   wsDayUse = DHWMF2BR07                // Day use profile object
   wsWF = 1                             // Water usage waste factor (applies to both old and new style use/profiles), frac
   wsSDLM = 1.135624                    // Standard distribution loss multiplier
   wsDSM = 0.85                         // Distribution system multiplier
   wsShowerCount = 1                    // Total number of showers served by this DHWSYS
   wsBathCount = 1                      // Total number of bathtubs served by this DHWSYS
   wsCWashrDrawDurF = 0                 // mult

DHWSYS   "dhwsys-DwellingUnit 87 DU"  
   wsCentralDHWSYS = "dhwsys-ResidentialDHWSystem 1"    // Central DHWSYS that this DHWSYS provides load info for
   wsDayUse = DHWMF2BR08                // Day use profile object
   wsWF = 1                             // Water usage waste factor (applies to both old and new style use/profiles), frac
   wsSDLM = 1.135624                    // Standard distribution loss multiplier
   wsDSM = 0.85                         // Distribution system multiplier
   wsShowerCount = 1                    // Total number of showers served by this DHWSYS
   wsBathCount = 1                      // Total number of bathtubs served by this DHWSYS
   wsCWashrDrawDurF = 0                 // mult

 verbose = -1          // suppress progress messages
 RUN                   // perform DHW (or DHWSolar) pre-run calcs
 UNSET verbose         // re-enable progress messages

IZXFER   "ResidentialCeilingBelowAttic 1-BypassxA"  
   izNVType = "NONE"                    // Choice determining interzone ventilation
   izZn1 = "A1_L4 1-zn"                 // Name of primary zone (flow rates > 0 are into the primary zone)
   izZn2 = "Attic-atc"                  // Name of secondary zone
   izHConst = 0.015 * 557 * select(@znRes["A1_L4 1-zn"].prior.H.tAir - @znRes["Attic-atc"].prior.H.tAir > 0., 1., default 0.)    // expression describing Conductance between zones, Btu/°F


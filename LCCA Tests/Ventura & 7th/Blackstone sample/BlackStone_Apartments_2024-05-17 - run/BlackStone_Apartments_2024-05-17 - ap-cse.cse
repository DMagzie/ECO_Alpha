   znCeilingHt = 9.25                   // Nominal zone ceiling height relative to zone floor (typically 8-10 ft), ft
   znFloorZ = 11                        // Nominal zone floor height relative to arbitrary 0 level, ft
   znCAir = 1114.602                    // Zone 'air' heat capacity: represents heat capacity of air, furniture, 'light' walls, and everything in zone except nonQUICK surfaces
   znSC = select( $radDiff >1., 0.5, default 0.8 )    // Expression representing zone shade closure
   znTH = select( $dsDay==1, 70, $dsDay==2, 60, ISSEASONCOOLING, 60, default 68)     // Expression representing heating setpoint, °F
   znTC = select( $dsDay==1, 83, $dsDay==2, 75, default 78)    // Expression representing cooling setpoint, °F

      gnPower = (1.34521 * 3412 / 24) * ( select( $isWeHol, RefrConst_WEH, default RefrConst_WD ) + select( $isWeHol, RefrTemp_WEH, default RefrTemp_WD ) * @znRes["A1_L3 9-zn"].prior.H.tAir)    // Expression representing internal gain power, Btuh

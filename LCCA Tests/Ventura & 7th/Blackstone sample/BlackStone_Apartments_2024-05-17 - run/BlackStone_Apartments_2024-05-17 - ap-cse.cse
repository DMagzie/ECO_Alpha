RSYS   "rsys-A1_L1 1 HVACSys"  
   rsType = "ASHP"                      // System type
   AUTOSIZE rsCapC
   AUTOSIZE rsCapAuxH
   rsFxCapC = 1.2                       // Cooling sizing factor
   rsFChg = 0.96                        // Refrigerant charge adjustment factor
   rsSEER = 16                          // Cooling SEER
   rsEER = 13                           // Cooling EER (required for *PkgRoom types)
   rsVfPerTon = 350                     // CFM per Ton (default = 350)
   rsFanPwrH = 0.58                     // Heating fan power.  Heating air flow is estimated based on a 50 ?F temperature rise.
   rsFanPwrC = 0.58                     // Cooling fan power.
   rsParElec = ($tdboHrAv < 50.) * (1.-@RSYSRes["rsys-A1_L1 1 HVACSys"].prior.H.hrsOn) * @RSYS["rsys-A1_L1 1 HVACSys"].capNomC * 10./12000.    // Parasitic electric use, W

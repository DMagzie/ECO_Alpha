   izZn1 = "A1_L4 11-zn"                // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0                            // Area of low or only vent (typically VentOff), ft2
   izAHi = 0.390 * WINDOWVENTAVAIL      // Additional vent area (high vent or VentOn)  (expression/formula), ft2
   izHD = 34.42                         // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 0.5                        // Vent discharge coefficient coefficient
   izCpr = -0.075                       // Wind pressure coefficient (for AIRNETEXT)
   izAFCat = "VentEx"                   // Air flow (infiltration) reporting category


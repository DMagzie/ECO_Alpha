        AIRHANDLER   "ResBaseAirSys_SZHP-ah"  
           ahSched = ON                         // Air handler schedule; OFF or ON, hourly schedulable by expression
           ahTsSp = ZN2                         // Supply temperature setpoint numeric value OR* choice of control method
           ahfanCycles = NO                     // Whether AH fan cycles with the zone thermostat
           ahTsMn = 58                          // Minimum supply temperature, °F
           ahTsMx = 95                          // Maximum supply temperature, °F
           sfanType = "DrawThru"                // Supply fan type/position
           sfanVfDs = 856.63845                 // Supply fan design or rated (volumetric) air flow at rated pressure, cfm
           sfanVfMxF = 1                        // Supply fan overrun factor: maximum factor by which fan will exceed rated flow (default 1.3), mult
           sfanElecPwr = 0.744                  // Supply fan input power per unit air flow (at design flow and pressure), W/cfm
           sfanMotEff = 0.855                   // Supply fan motor/drive efficiency, frac
           sfanMotPos = IN_FLOW                 // Supply fan motor/drive position
           sfanMtr = "MtrElec"                  // Name of METER to accumulate energy use by this supply fan
           ahhcType = "AHP"                     // Heating coil type
           ahhcCapTRat = 32555.005795           // Total heating coil (output) capacity, Btuh
           ahhcMtr = "MtrElec"                  // Name of METER to accumulate energy use by this heating coil
           ahpCap17 = 16244.947892              // AHRI steady state rated capacity at 70 degF indoor (return), and 17 degF outdoor air temp, respectively, Btuh
           ahpCOP47 = 3.776227                  // Steady state (full power, no cycling) COP for compressor and crankcase heater at 47 degF outdoor and 70 indoor, kW
           ahpCOP17 = 2.311834                  // Steady state (full power, no cycling) COP for compressor and crankcase heater at 17 degF outdoor and 70 indoor, kW
           ahpCapSupH = 29547.625               // Output capacity of the heat pump's supplemental heating coil, Btuh

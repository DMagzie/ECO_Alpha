           GAIN   "A1.1_L5-znRfrg"  
              gnMeter = "MtrElec"               // Meter that tracks internal gain
              gnEndUse = "Refr"                 // Internal gain enduse
              gnPower = (1.34521 * 3412 / 24) * ( select( $isWeHol, RefrConst_WEH, default RefrConst_WD ) + select( $isWeHol, RefrTemp_WEH, default RefrTemp_WD ) * @znRes["A1.1_L5-zn"].prior.H.tAir)    // Expression representing internal gain power, Btuh

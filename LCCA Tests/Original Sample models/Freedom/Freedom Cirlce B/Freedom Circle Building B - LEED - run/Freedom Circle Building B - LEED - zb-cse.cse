      gnEndUse = "Rcp"                  // Internal gain enduse
      gnPower = 9046.94 * select( $dsDay==1, 0., $ISWEHOL, RMEL_WEH, Default RMEL_WD) * Other_SM    // Expression representing internal gain power, Btuh

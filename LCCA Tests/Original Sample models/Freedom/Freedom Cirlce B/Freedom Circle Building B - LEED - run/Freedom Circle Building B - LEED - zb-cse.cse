   znFloorZ = 33                        // Nominal zone floor height relative to arbitrary 0 level, ft
   znCAir = 2280                        // Zone 'air' heat capacity: represents heat capacity of air, furniture, 'light' walls, and everything in zone except nonQUICK surfaces

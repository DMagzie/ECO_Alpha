   TERMINAL   "FITNESS CENTER_L03-tu"  
      tuAh = "ResBaseAirSys_SZHP-19-ah"    // AirHandler serving this Terminal (and parent Zone)
      tuTH = 68                         // Air heating thermostat setpoint, °F
      tuTC = 78                         // Air cooling thermostat setpoint, °F
      AUTOSIZE tuVfMxC
      AUTOSIZE tuVfMxH
      AUTOSIZE tuVfMn

   znVol = 12661                        // Zone volume, ft3
   znEaveZ = 33                         // Height of top of the wall in this zone above the ground, ft
   znCeilingHt = 11                     // Nominal zone ceiling height relative to zone floor (typically 8-10 ft), ft
   znFloorZ = 22                        // Nominal zone floor height relative to arbitrary 0 level, ft
   znCAir = 2302                        // Zone 'air' heat capacity: represents heat capacity of air, furniture, 'light' walls, and everything in zone except nonQUICK surfaces

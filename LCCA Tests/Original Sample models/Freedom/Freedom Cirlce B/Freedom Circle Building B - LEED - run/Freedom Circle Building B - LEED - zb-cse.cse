      gnEndUse = "Rcp"                  // Internal gain enduse
      gnPower = 9046.94 * select( $dsDay==1, 0., $ISWEHOL, RMEL_WEH, Default RMEL_WD) * Other_SM    // Expression representing internal gain power, Btuh
      gnFrRad = 0.3                     // Fraction of internal gain to Zone that is Radiant (single value or hourly profile)
      gnFrLat = 0.03                    // Fraction of internal gain to Zone that is Latent (single value or hourly profile)

   GAIN   "B2.5_B 53_L07-znRfrg"  
      gnMeter = "MtrElec"               // Meter that tracks internal gain
      gnEndUse = "Refr"                 // Internal gain enduse
      gnPower = (1.44658 * 3412 / 24) * ( select( $isWeHol, RefrConst_WEH, default RefrConst_WD ) + select( $isWeHol, RefrTemp_WEH, default RefrTemp_WD ) * @znRes["B2.5_B 53_L07-zn"].prior.H.tAir)    // Expression representing internal gain power, Btuh

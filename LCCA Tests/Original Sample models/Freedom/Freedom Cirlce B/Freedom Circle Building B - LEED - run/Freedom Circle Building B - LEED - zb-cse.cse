      gnMeter = "MtrElec2"              // Meter that tracks internal gain
      gnEndUse = "Lit"                  // Internal gain enduse
      gnPower = 0.55 * 201.937 * 3.412 * select( $dsDay==1, 0, $dsDay==2, 1, $DOWH==1, hourval(0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.3,0.3,0.3,0.3,0.3,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.05,0.05), $DOWH==8, hourval(0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.3,0.3,0.3,0.3,0.3,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.55,0.05,0.05), $DOWH==7, hourval(0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.3,0.3,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.4,0.05), default hourval(0.05,0.05,0.05,0.05,0.05,0.05,0.35,0.35,0.35,0.65,0.65,0.65,0.65,0.65,0.65,0.65,0.65,0.65,0.65,0.65,0.65,0.65,0.25,0.05) )    // Expression representing internal gain power, Btuh

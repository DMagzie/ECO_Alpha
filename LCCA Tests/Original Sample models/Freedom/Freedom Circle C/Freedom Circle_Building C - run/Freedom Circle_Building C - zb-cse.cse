 verbose = -1          // suppress progress messages
 RUN                   // perform DHW (or DHWSolar) pre-run calcs
 UNSET verbose         // re-enable progress messages

IZXFER   "A1.0 MTL_L1-InfLU"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "A1.0 MTL_L1-zn"             // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0.164143                     // Area of low or only vent (typically VentOff), ft2
   izHD = 13.5                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = 0.6                          // Wind pressure coefficient (for AIRNETEXT)
   izExp = 0.65                         // Opening exponent

IZXFER   "A1.0 MTL_L1-InfLS"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "A1.0 MTL_L1-zn"             // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0.328285                     // Area of low or only vent (typically VentOff), ft2
   izHD = 13.5                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = -0.65                        // Wind pressure coefficient (for AIRNETEXT)
   izExp = 0.65                         // Opening exponent

IZXFER   "A1.0 MTL_L1-InfLD"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "A1.0 MTL_L1-zn"             // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0.164143                     // Area of low or only vent (typically VentOff), ft2
   izHD = 13.5                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = -0.3                         // Wind pressure coefficient (for AIRNETEXT)
   izExp = 0.65                         // Opening exponent

IZXFER   "A1.0 MTL_L1-InfHU"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "A1.0 MTL_L1-zn"             // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0.164143                     // Area of low or only vent (typically VentOff), ft2
   izHD = 20.5                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = 0.6                          // Wind pressure coefficient (for AIRNETEXT)

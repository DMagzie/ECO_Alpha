EXPORTFILE   "xf-dhwSolarSys-SSF"  
   xfFileName = "Freedom Circle_Building C - zb-cse-SSF.csv"    // Name of file to write simulation results to
   endEXPORTFILE

EXPORTFILE   "xf-hvacSzg"  
   xfFileName = "Freedom Circle_Building C - zb-hvacSzg.csv"    // Name of file to write simulation results to
   endEXPORTFILE

EXPORTFILE   "xf-trmlSzg"  
   xfFileName = "Freedom Circle_Building C - zb-trmlSzg.csv"    // Name of file to write simulation results to
   endEXPORTFILE

EXPORT   "ExportElec"  
   exExportfile = "Primary"             // Name of EXPORTFILE to write simulation results to
   exType = "MTR"                       // Export type
   exFreq = "HOUR"                      // Time interval for generating rows of export data
   exMeter = "MtrElec"                  // Meter to report
   exBtuSf = 1000                       // Result scaling factor (1,000 reports kBtu)
   exDayBeg = Jan 1                     // initial day of export period
   exDayEnd = Dec 31                    // final day of export period

EXPORT   "ExportNatGas"  
   exExportfile = "Primary"             // Name of EXPORTFILE to write simulation results to
   exType = "MTR"                       // Export type
   exFreq = "HOUR"                      // Time interval for generating rows of export data
   exMeter = "MtrNatGas"                // Meter to report
   exBtuSf = 1000                       // Result scaling factor (1,000 reports kBtu)
   exDayBeg = Jan 1                     // initial day of export period
   exDayEnd = Dec 31                    // final day of export period

EXPORT   "ExportElec2"  
   exExportfile = "Primary"             // Name of EXPORTFILE to write simulation results to
   exType = "MTR"                       // Export type
   exFreq = "HOUR"                      // Time interval for generating rows of export data
   exMeter = "MtrElec2"                 // Meter to report
   exBtuSf = 1000                       // Result scaling factor (1,000 reports kBtu)
   exDayBeg = Jan 1                     // initial day of export period
   exDayEnd = Dec 31                    // final day of export period

EXPORT   "x-dhwSolarSys-SSF"  
   exExportfile = "xf-dhwSolarSys-SSF"    // Name of EXPORTFILE to write simulation results to
   exType = "UDT"                       // Export type
   exFreq = "YEAR"                      // Time interval for generating rows of export data
   exHeader = "YESIFNEW"                // export header which gives the export type, object being exported, time interval, column headings, etc.
   exFooter = "NO"                      // export footer (choose NO to suppress)

   EXPORTCOL   "xc-dhwSolarSys-SSF-1"  
      colVal = @Top.runDateTime         // Value to show in this position in each row of export
      colHead = "TimeStamp"             // Text used for field name in export header

   EXPORTCOL   "xc-dhwSolarSys-SSF-2"  
      colVal = ClimateZone              // Value to show in this position in each row of export
      colHead = "CZ"                    // Text used for field name in export header

   EXPORTCOL   "xc-dhwSolarSys-SSF-3"  
      colVal = "t24-Std SolarSys"       // Value to show in this position in each row of export
      colHead = "Name"                  // Text used for field name in export header

   EXPORTCOL   "xc-dhwSolarSys-SSF-4"  
      colVal = @DhwSolarSys["dhwss-t24-Std SolarSys"].SSFAnnual    // Value to show in this position in each row of export
      colHead = "SSF"                   // Text used for field name in export header
      colDec = 3                        // Number of digits after decimal point

EXPORT   "x-hvacSzg"  
   exExportfile = "xf-hvacSzg"          // Name of EXPORTFILE to write simulation results to
   exType = "UDT"                       // Export type
   exFreq = "YEAR"                      // Time interval for generating rows of export data
   exHeader = "COLUMNSONLY"             // export header which gives the export type, object being exported, time interval, column headings, etc.

   EXPORTCOL   "xc-hvacSzg"  
      colVal = @top.runDateTime         // Value to show in this position in each row of export
      colHead = "runDateTime"           // Text used for field name in export header

   EXPORTCOL   "xc-ResBaseAirSys_SZHP-Name"  
      colVal = "ResBaseAirSys_SZHP"     // Value to show in this position in each row of export
      colHead = "SysName"               // Text used for field name in export header

   EXPORTCOL   "xc-ResBaseAirSys_SZHP-HtgCap"  
      colVal = @airHandler["ResBaseAirSys_SZHP-ah"].ahhc.captRat    // Value to show in this position in each row of export
      colHead = "HtgCap"                // Text used for field name in export header

   EXPORTCOL   "xc-ResBaseAirSys_SZHP-ClgTCap"  
      colVal = -@airHandler["ResBaseAirSys_SZHP-ah"].ahcc.captRat    // Value to show in this position in each row of export
      colHead = "ClgTCap"               // Text used for field name in export header

   EXPORTCOL   "xc-ResBaseAirSys_SZHP-ClgSCap"  
      colVal = -@airHandler["ResBaseAirSys_SZHP-ah"].ahcc.capsRat    // Value to show in this position in each row of export

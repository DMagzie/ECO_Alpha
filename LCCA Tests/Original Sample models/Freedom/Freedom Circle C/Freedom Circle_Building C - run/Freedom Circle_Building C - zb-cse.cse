   znEaveZ = 57.5833                    // Height of top of the wall in this zone above the ground, ft
   znCeilingHt = 10.5833                // Nominal zone ceiling height relative to zone floor (typically 8-10 ft), ft
   znFloorZ = 47                        // Nominal zone floor height relative to arbitrary 0 level, ft
   znCAir = 1642                        // Zone 'air' heat capacity: represents heat capacity of air, furniture, 'light' walls, and everything in zone except nonQUICK surfaces

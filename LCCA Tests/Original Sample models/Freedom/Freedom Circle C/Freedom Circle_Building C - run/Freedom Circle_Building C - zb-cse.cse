IZXFER   "A1.0 MTL_L1-NVLU"  
   izNVType = "AIRNETEXT"               // Choice determining interzone ventilation
   izZn1 = "A1.0 MTL_L1-zn"             // Name of primary zone (flow rates > 0 are into the primary zone)
   izALo = 0                            // Area of low or only vent (typically VentOff), ft2
   izAHi = 3.902 * WINDOWVENTAVAIL      // Additional vent area (high vent or VentOn)  (expression/formula), ft2
   izHD = 19.67                         // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 0.5                        // Vent discharge coefficient coefficient

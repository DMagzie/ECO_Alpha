      gnPower = (1.34521 * 3412 / 24) * ( select( $isWeHol, RefrConst_WEH, default RefrConst_WD ) + select( $isWeHol, RefrTemp_WEH, default RefrTemp_WD ) * @znRes["A16.2_L3-zn"].prior.H.tAir)    // Expression representing internal gain power, Btuh

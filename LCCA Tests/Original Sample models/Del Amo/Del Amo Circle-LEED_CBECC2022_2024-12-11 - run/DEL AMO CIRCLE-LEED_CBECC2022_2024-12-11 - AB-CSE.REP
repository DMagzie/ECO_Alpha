              gnEndUse = "Refr"                 // Internal gain enduse
              gnPower = (1.44658 * 3412 / 24) * ( select( $isWeHol, RefrConst_WEH, default RefrConst_WD ) + select( $isWeHol, RefrTemp_WEH, default RefrTemp_WD ) * @znRes["B4.1_L03-zn"].prior.H.tAir)    // Expression representing internal gain power, Btuh

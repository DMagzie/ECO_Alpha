      gnEndUse = "Cook"                 // Internal gain enduse
      gnPower = 7202.59 * select( $dsDay==1, 0., $ISWEHOL, Cook_WEH, Default Cook_WD) * Cook_SM    // Expression representing internal gain power, Btuh
      gnFrZn = 0.9                      // Fraction of internal gain to Zone (single value or hourly profile)

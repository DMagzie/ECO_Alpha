   pvArrayType = "FixedOpenRack"
   pvTilt = 22.619884                   // deg
   pvAzm = 170                          // deg
   pvSIF = 2                            // frac
   pvInverterEff = 0.96                 // frac
   pvSysLosses = 0.1744                 // frac
   pvElecMtr = "MtrElec"

EXPORTFILE   "xf-hvacSzg"  
   xfFileName = "MF36Unit_3Story_ELEC-CZ02 - zp-hvacSzg.csv"    // Name of file to write simulation results to
   endEXPORTFILE


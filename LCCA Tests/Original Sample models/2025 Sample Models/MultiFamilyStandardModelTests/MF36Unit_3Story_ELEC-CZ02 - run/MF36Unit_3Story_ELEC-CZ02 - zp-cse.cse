   izALo = 0.085446                     // Area of low or only vent (typically VentOff), ft2
   izHD = 2.95                          // Vent center-to-center height difference (for TWOWAY) or vent height above nominal 0 level (for AirNet types), ft
   izNVEff = 1                          // Vent discharge coefficient coefficient
   izCpr = 0.6                          // Wind pressure coefficient (for AIRNETEXT)
   izExp = 0.65                         // Opening exponent


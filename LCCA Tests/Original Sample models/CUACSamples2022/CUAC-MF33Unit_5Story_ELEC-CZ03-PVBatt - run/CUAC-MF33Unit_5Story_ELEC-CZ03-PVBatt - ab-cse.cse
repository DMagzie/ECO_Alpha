   znCeilingHt = 9                      // Nominal zone ceiling height relative to zone floor (typically 8-10 ft), ft
   znFloorZ = 30                        // Nominal zone floor height relative to arbitrary 0 level, ft
   znCAir = 1524                        // Zone 'air' heat capacity: represents heat capacity of air, furniture, 'light' walls, and everything in zone except nonQUICK surfaces
   znSC = select( $radDiff >1., 0.5, default 0.8 )    // Expression representing zone shade closure
